# =============================================================
# HARWEST BACKEND SERVER - PRODUCTION ENVIRONMENT VARIABLES
# =============================================================
PORT=5000
NODE_ENV=production
TZ=Asia/Kolkata

# --- Frontend Client URL(s) ---
# Put your deployed frontend URL here so CORS and cookies are allowed.
# Example: https://harwest.vercel.app (or multiple: https://harwest.vercel.app,https://yourcustomdomain.com)
CLIENT_ORIGIN=https://your-frontend-domain.com

# --- MongoDB Atlas Connection String ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/harwest

# --- Cloudinary Storage ---
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Trash / Cleanup Deletion Delay (seconds) ---
TRASH_TIMER_SECONDS=1800

# --- JWT Secret for Admin Sessions ---
JWT_SECRET=your_super_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# --- Admin Account Seed ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecurePassword123!

MAX_UPLOAD_MB=50

